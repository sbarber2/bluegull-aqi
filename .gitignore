
# ---------------------------------------------------------------------------
# Secrets and credentials — NEVER commit these.
# See doc/DESIGN.md "Secrets & credentials" for the full policy and inventory.
# This list is a safety net, not the control: gitleaks (pre-commit + CI) and
# GitHub push protection are what actually enforce the rule.
# ---------------------------------------------------------------------------

# Local environment files (commit .env.example instead, with placeholder values)
.env
.env.*
!.env.example

# direnv -- .envrc commonly holds real secrets as plain exports (AWS profile,
# API keys); .env.* above does NOT match this filename, so it needs its own
# entry. Never commit this.
.envrc

# Keys, certificates, provisioning profiles
*.pem
*.key
*.p12
*.pfx
*.cer
*.der
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# Cloud / service credentials
.aws/
credentials.json
secrets.json
*-credentials.json
*_rsa
*_dsa
*_ed25519
*_ecdsa

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python / Poetry / SAM build artifacts
__pycache__/
*.pyc
.venv/
.pytest_cache/
.aws-sam/
poetry.toml

# DynamoDB Local (downloaded by `make dynamodb-local-setup`, ~130MB unpacked --
# never committed) and its runtime data/logs
service/.dynamodb-local/
service/var/
service/logs/
service/dynamodb-local-metadata.json

# Swift Package Manager / Xcode build artifacts
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
