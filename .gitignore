
# ---------------------------------------------------------------------------
# Secrets and credentials — NEVER commit these.
# See doc/DESIGN.md "Secrets & credentials" for the full policy and inventory.
# This list is a safety net, not the control: Betterleaks (pre-commit + CI) and
# GitHub push protection are what actually enforce the rule.
# ---------------------------------------------------------------------------

# Local environment files (commit .env.example instead, with placeholder values)
.env
.env.*
!.env.example

# direnv -- .envrc commonly holds real secrets as plain exports (AWS profile,
# API keys); .env.* above does NOT match this filename, so it needs its own
# entry. Never commit this.
.envrc

# Keys, certificates, provisioning profiles
*.pem
*.key
*.p12
*.pfx
*.cer
*.der
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# Cloud / service credentials
.aws/
credentials.json
secrets.json
*-credentials.json
*_rsa
*_dsa
*_ed25519
*_ecdsa

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python / Poetry / SAM build artifacts
__pycache__/
*.pyc
.venv/
.pytest_cache/
.aws-sam/
poetry.toml

# DynamoDB Local (downloaded by `make dynamodb-local-setup`, ~130MB unpacked --
# never committed) and its runtime data/logs
service/.dynamodb-local/
service/var/
service/logs/
service/dynamodb-local-metadata.json

# Swift Package Manager / Xcode build artifacts
.build/
.swiftpm/
# The whole .xcodeproj, not just xcuserdata -- entirely generated by
# `xcodegen generate` from mac-app/project.yml (bluegull-aqi-e70.17).
# project.yml is the real source of truth; committing the generated
# project.pbxproj/scheme/workspace just produced noisy, hard-to-read diffs
# on every regenerate (e.g. DEVELOPMENT_TEAM getting silently wiped and
# re-added). Run `xcodegen generate` (or any `make` target, which does
# this first) to recreate it locally -- see doc/DEVINSTALL.md.
# Leading **/ matters: a bare "*.xcodeproj/" has no slash in the
# middle here, so it's fine, but the xcuserdata rules below predate this
# broader one and are kept for the documented gotcha they already caught.
**/*.xcodeproj/
# Leading **/ matters: a bare "*.xcodeproj/xcuserdata/" has a slash in the
# middle, which git anchors to the directory containing this .gitignore
# (the repo root) -- it silently never matched mac-app/BluegullAQI.xcodeproj/
# xcuserdata/ (nested, not at root). Caught once an actual .xcodeproj
# existed to test against (bluegull-aqi-e70.1); latent before that. Now
# redundant with the broader **/*.xcodeproj/ rule above, kept for the
# lesson.
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
DerivedData/

# `make app-package` scratch dir (xcarchive, exported .app, zip, dmg) --
# rebuilt from scratch every run, never committed.
mac-app/build/

# Repo-root scratch dir for manual Xcode Organizer exports (archive/DMG),
# same reasoning as mac-app/build/ above -- never committed.
/dist/

# macOS Finder metadata -- never useful in version control, appears
# anywhere Finder/`open` touches a directory.
.DS_Store
