# Copy to .env (gitignored, never committed) and fill in real values for
# local development. See doc/DESIGN.md "Secrets & credentials".

# The service's own AirNow API key (from https://docs.airnowapi.org),
# not a user's direct-mode key -- that one lives in the user's iCloud
# Keychain, never here.
#
# Recommended: store it in 1Password and reference it here instead of a
# literal value, e.g.:
#   AIRNOW_API_KEY=op://BlueGull/BlueGull AQI - AirNow API Key/credential
# Then invoke via `op run` so the reference actually resolves:
#   op run --env-file=.env -- make run-local
# A bare `make run-local` without the `op run` prefix will pass the literal
# "op://..." string to AirNow and get a confusing 401 -- op run is what
# resolves it, this file alone does not.
AIRNOW_API_KEY=your-airnow-api-key-here

# DynamoDB Local endpoint for local dev/tests (bluegull-aqi-q9r.11).
# Leave unset to use real AWS DynamoDB instead.
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-2

LOG_LEVEL=DEBUG
