# Copy to .env (gitignored, never committed) and fill in real values for
# local development. See doc/DESIGN.md "Secrets & credentials".

# The service's own AirNow API key (from https://docs.airnowapi.org),
# not a user's direct-mode key -- that one lives in the user's iCloud
# Keychain, never here.
AIRNOW_API_KEY=your-airnow-api-key-here

# DynamoDB Local endpoint for local dev/tests (bluegull-aqi-q9r.11).
# Leave unset to use real AWS DynamoDB instead.
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-1

LOG_LEVEL=DEBUG
